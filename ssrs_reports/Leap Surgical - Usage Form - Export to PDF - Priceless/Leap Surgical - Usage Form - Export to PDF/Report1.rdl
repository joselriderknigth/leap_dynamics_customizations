    <DataSet Name="DynamicsUsageFormDetail">
      <Query>
        <DataSourceName>LeapSurgicalDynamicsCRM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="CRM_FilteredUsageForm">
            <Value>=Parameters!CRM_FilteredUsageForm.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false"&gt;
  &lt;entity name="leap_usageform" enableprefiltering="1" prefilterparametername="CRM_FilteredUsageForm"&gt;
    &lt;attribute name="leap_usageformid" /&gt;
    &lt;attribute name="leap_name" /&gt;
    &lt;attribute name="createdon" /&gt;
     &lt;attribute name="leap_hospitalowned" /&gt; 
    &lt;order attribute="leap_name" descending="false" /&gt;
    &lt;link-entity name="leap_usageformdetail" from="leap_usageform" to="leap_usageformid" link-type="inner" alias="ag"&gt;
      &lt;filter type="and"&gt;
	    &lt;condition attribute="statecode" operator="eq" value="0"/&gt;
	  &lt;/filter&gt;
	  &lt;attribute name="leap_product" /&gt;
      &lt;attribute name="leap_catalognumber" /&gt;
      &lt;attribute name="leap_lotnumber" /&gt;
      &lt;attribute name="leap_serialnumber" /&gt;
      &lt;attribute name="leap_expirationdate" /&gt;
      &lt;attribute name="leap_restock" /&gt;
      &lt;attribute name="leap_io" /&gt;
      &lt;attribute name="leap_qty" /&gt;
      &lt;attribute name="leap_unitprice" /&gt;
      &lt;attribute name="leap_extendedprice" /&gt;
	  &lt;attribute name="leap_newproductname" /&gt;
    &lt;/link-entity&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText>
        <Timeout>1</Timeout>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
