    <DataSet Name="DataSetEnvVariable">
      <Query>
        <DataSourceName>LeapSurgicalDynamicsCRM</DataSourceName>
        <CommandText>&lt;fetch top="1"&gt;
  &lt;entity name="environmentvariabledefinition"&gt;
    &lt;attribute name="defaultvalue" /&gt;
    &lt;attribute name="schemaname" /&gt;
    &lt;filter&gt;
      &lt;condition attribute="schemaname" operator="eq" value="leap_poemaildefault" /&gt;
    &lt;/filter&gt;
    &lt;link-entity name="environmentvariablevalue" from="environmentvariabledefinitionid" to="environmentvariabledefinitionid" link-type="outer" alias="val"&gt;
      &lt;attribute name="value" /&gt;
    &lt;/link-entity&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText>
      </Query>
      <Fields>
        <Field Name="schemaname">
          <DataField>schemaname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="val_value">
          <DataField>val_value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="defaultvalue">
          <DataField>defaultvalue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="GenerateHospitalOwnedPDF">
      <Query>
        <DataSourceName>LeapSurgicalDynamicsCRM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="CRM_FilteredUsageForm">
            <Value>=Parameters!CRM_FilteredUsageForm.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>&lt;fetch version="1.0"
       output-format="xml-platform"
       mapping="logical"
       distinct="false"&gt;

  &lt;entity name="leap_usageform"
          enableprefiltering="1"
          prefilterparametername="CRM_FilteredUsageForm"&gt;

    &lt;attribute name="leap_usageformid" /&gt;
    &lt;attribute name="leap_generatehospitalownedpdf" /&gt;
    &lt;attribute name="leap_hospitalowned" /&gt;

  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText>
      </Query>
      <Fields>
        <Field Name="leap_usageformid">
          <DataField>leap_usageformid</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="leap_generatehospitalownedpdf">
          <DataField>leap_generatehospitalownedpdf</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="leap_generatehospitalownedpdfValue">
          <DataField>leap_generatehospitalownedpdfValue</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="leap_hospitalowned">
          <DataField>leap_hospitalowned</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="leap_hospitalownedValue">
          <DataField>leap_hospitalownedValue</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DynamicsUsageFormHODetail">
      <Query>
        <DataSourceName>LeapSurgicalDynamicsCRM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="CRM_FilteredUsageForm">
            <Value>=Parameters!CRM_FilteredUsageForm.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>&lt;fetch version="1.0"
       output-format="xml-platform"
       mapping="logical"
       distinct="false"&gt;

  &lt;entity name="leap_usageform"&gt;

    &lt;attribute name="leap_usageformid" /&gt;
    &lt;attribute name="leap_name" /&gt;
    &lt;attribute name="createdon" /&gt;
    &lt;attribute name="leap_hospitalowned" /&gt;
    &lt;attribute name="leap_supplier" /&gt;

    &lt;order attribute="leap_name" descending="false" /&gt;

    &lt;filter type="and"&gt;
      &lt;condition attribute="leap_hospitalowned" operator="eq" value="1" /&gt;
    &lt;/filter&gt;

    &lt;link-entity name="leap_usageform"
                 from="leap_case"
                 to="leap_case"
                 alias="ufParam"
                 link-type="inner"
                 enableprefiltering="1"
                 prefilterparametername="CRM_FilteredUsageForm" /&gt;

    &lt;filter type="and"&gt;
      &lt;condition attribute="leap_supplier"
                 operator="eq"
                 valueof="ufParam.leap_supplier" /&gt;
    &lt;/filter&gt;

    &lt;link-entity name="leap_usageformdetail"
                 from="leap_usageform"
                 to="leap_usageformid"
                 link-type="inner"
                 alias="ag"&gt;

      &lt;filter type="and"&gt;
        &lt;condition attribute="statecode" operator="eq" value="0" /&gt;
      &lt;/filter&gt;

      &lt;attribute name="leap_product" /&gt;
      &lt;attribute name="leap_catalognumber" /&gt;
      &lt;attribute name="leap_lotnumber" /&gt;
      &lt;attribute name="leap_serialnumber" /&gt;
      &lt;attribute name="leap_expirationdate" /&gt;
      &lt;attribute name="leap_restock" /&gt;
      &lt;attribute name="leap_io" /&gt;
      &lt;attribute name="leap_qty" /&gt;
      &lt;attribute name="leap_unitprice" /&gt;
      &lt;attribute name="leap_extendedprice" /&gt;
      &lt;attribute name="leap_overrideprice" /&gt;
      &lt;attribute name="leap_unitpriceoverride" /&gt;
      &lt;attribute name="leap_newproductname" /&gt;

    &lt;/link-entity&gt;

  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText>
      </Query>
