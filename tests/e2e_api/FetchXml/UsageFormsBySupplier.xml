<fetch version="1.0" mapping="logical" no-lock="false" distinct="true">
  <entity name="leap_usageform">
    <attribute name="statecode" />
    <attribute name="leap_total" />
    <attribute name="statuscode" />
    <attribute name="leap_supplier" />
    <attribute name="leap_name" />
    <attribute name="leap_usageformid" />
    <attribute name="leap_hospitalowned" />
    <filter type="and">
      <condition attribute="statecode" operator="eq" value="0" />
      <condition attribute="leap_supplier" operator="eq" value="{SUPPLIER_ID}" />
      <condition attribute="leap_case" operator="eq" value="{CASE_ID}" />
    </filter>
  </entity>
</fetch>
